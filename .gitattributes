crates/server/tests/fixtures/editors/** text eol=lf
# A migration is identified by a checksum of its bytes, so its line endings must not depend on
# the checkout: with CRLF a database migrated from an LF copy refuses to start.
crates/records/migrations/*.sql text eol=lf

# Image fixtures are bytes, never text.
crates/server/tests/fixtures/images/** binary

# The Windows scripts run on Windows only: cmd needs CRLF, and PowerShell reads either.
packaging/windows/**/*.cmd text eol=crlf
packaging/windows/**/*.ps1 text eol=crlf
